{
  "functions": [{ "source": "functions", "codebase": "sara-reports", "ignore": ["node_modules", "*.test.mjs", ".env*", "firebase-debug.log*"] }],
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "site": "ai-5f115",
    "public": "docs/app-store-legal",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      { "source": "/", "destination": "/privacy-policy", "type": 302 },
      { "source": "/privacy", "destination": "/privacy-policy", "type": 301 }
    ],
    "headers": [{
      "source": "**",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }]
  }
}
