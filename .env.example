# Public URL of the separate ሳራ chat server (safe to include in the app bundle).
# For an iOS simulator or local web preview, localhost works. For a physical phone,
# use your computer's LAN IP and set CHAT_SERVER_HOST=0.0.0.0 below.
EXPO_PUBLIC_CHAT_API_URL=http://localhost:8787

# Server-only values. Keep the real key in .env.local, which is gitignored.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
CHAT_SERVER_HOST=127.0.0.1
CHAT_SERVER_PORT=8787
CHAT_ALLOWED_ORIGIN=http://localhost:8081
