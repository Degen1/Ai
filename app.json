{
  "expo": {
    "name": "ሳራ",
    "slug": "ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.degengebre.ai",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.degengebre.ai",
      "googleServicesFile": "./google-services.json",
      "permissions": ["com.android.vending.BILLING"],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F7F3"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ሳራ ናብ ስእልታትካ ክትኣቱ ፍቐደላ፣ ኣብ ዕላልካ ስእሊ ክትውስኽ ወይ ናይ መገለጺ ስእሊ ክትመርጽ ክትክእል።",
          "microphonePermission": false
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/auth",
      "./plugins/with-purchases",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-8642966339570216~9617544643",
          "androidAppId": "ca-app-pub-8642966339570216~5873740753",
